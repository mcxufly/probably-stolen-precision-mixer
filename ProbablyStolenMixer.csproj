<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ProbablyStolenMixer</AssemblyName>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Copyright>Copyright (C) 2026 XuFly</Copyright>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameDir Condition="'$(GameDir)' == ''">/data/SteamLibrary/steamapps/common/Probably Stolen</GameDir>
    <ManagedDir>$(GameDir)/Probably Stolen_Data/Managed</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(ManagedDir)/Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(ManagedDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDir)/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="StageMod" AfterTargets="Build">
    <ItemGroup><ModAssets Include="assets/**/*" /></ItemGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)/dist/PrecisionMixer" />
    <Copy SourceFiles="@(ModAssets)" DestinationFiles="@(ModAssets->'$(MSBuildProjectDirectory)/dist/PrecisionMixer/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/README.md;$(MSBuildProjectDirectory)/LICENSE;$(MSBuildProjectDirectory)/NOTICE" DestinationFolder="$(MSBuildProjectDirectory)/dist/PrecisionMixer" />
  </Target>
</Project>
